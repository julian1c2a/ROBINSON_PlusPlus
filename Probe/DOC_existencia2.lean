run_cmd do
  let env ← getEnv
  let tset : Std.HashSet String := Std.HashSet.ofList toks
  let hits := env.constants.fold (init := (∅ : Std.HashMap String (Array Name))) fun acc n _ =>
    if esInterno2 n then acc else
    match n with
    | .str _ s => if tset.contains s then acc.insert s ((acc.getD s #[]).push n) else acc
    | _ => acc
  let mut out : Array String := #[]
  for s in toks do
    match hits.get? s with
    | none => out := out.push s!"AUSENTE  {s}"
    | some arr => out := out.push s!"EXISTE   {s}  ->  {String.intercalate " | " (arr.toList.map (fun n => s!"{n} @@ {modOf2 env n}"))}"
  IO.FS.writeFile "C:/msys64/tmp/claude/e--dropbox-github-lean4-ROBINSON-PlusPlus/85b0df6c-1e14-407d-a9ae-04b9e8841ed5/scratchpad/censo2.txt" (String.intercalate "\n" out.toList)
  logInfo "censo2 ok"
