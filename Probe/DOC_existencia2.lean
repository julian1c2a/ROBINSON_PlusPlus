def modOf2 (env : Environment) (n : Name) : String :=
  match env.getModuleIdxFor? n with
  | some idx => toString (env.header.moduleNames[idx.toNat]!)
  | none => "<current>"

def esInterno2 (n : Name) : Bool := n.isInternal

